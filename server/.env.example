# Copy this file to `.env` and fill in real values. Never commit `.env`.

# MongoDB Atlas connection string (Atlas > Database > Connect > Drivers).
# Include a database name in the path, e.g. .../taskmanager?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/taskmanager?retryWrites=true&w=majority

# Long random string (min 32 chars) used to sign auth tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-characters

# Port the API listens on
PORT=4000

# Origin of the frontend (used for CORS)
CLIENT_ORIGIN=http://localhost:5173
